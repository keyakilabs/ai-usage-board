    "token",
    "cost",
    "local"
  ],
  "homepage": "https://www.keyaki-labs.com/products/ai-usage-board",
  "bugs": {
    "url": "https://github.com/keyakilabs/ai-usage-board/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyakilabs/ai-usage-board.git"
  },
  "license": "MIT",
  "author": "Keyaki Labs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ai-usage-board": "./bin/ai-usage-board.js"
  },
